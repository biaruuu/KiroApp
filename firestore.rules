rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The developer account (signed in with a verified email).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yurischevalier@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Everything a user saves lives under users/{their uid} and only they can touch it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Messages from Contact us: signed-in users can send; only the developer can read or delete them.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
      allow read, delete: if isAdmin();
    }

    // Community chat: signed-in users read it and write their own messages. Only the developer can
    // mark a message as "dev" or tag everyone; you can delete your own message, the developer any.
    match /community/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (!('img' in request.resource.data) || request.resource.data.img.size() <= 240000)
        && (request.resource.data.get('dev', false) == false || isAdmin())
        && (request.resource.data.get('everyone', false) == false || isAdmin());
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Announcements and the developer's public card: everyone can read, only the developer can write.
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Settings that hold a secret (the speech-to-text key for automatic captions): developer only, even to read.
    match /adminconfig/{doc} {
      allow read, write: if isAdmin();
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avatar decorations and library looks: everyone can read, only the developer publishes.
    match /designs/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // The image itself, stored in numbered parts (a document holds at most 1 MB).
      match /parts/{part} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // "Report broken episode": signed-in users send one, only the developer reads and clears them.
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // Who is online and what they watch: each user writes their own, only the developer can read.
    match /presence/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Watch parties: the host writes the playback state, anyone signed in who knows the 6 letter
    // code can read it (but the list of parties cannot be browsed). Members add or remove themselves.
    match /parties/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
        // The host can remove someone from the room.
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/parties/$(code)).data.hostUid == request.auth.uid;
      }
      // Asking to join: a guest writes their own request (pending); only the host can accept or decline it.
      match /requests/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && ((request.auth.uid == uid && request.resource.data.status == "pending")
            || get(/databases/$(database)/documents/parties/$(code)).data.hostUid == request.auth.uid);
        allow delete: if request.auth != null && (request.auth.uid == uid
          || get(/databases/$(database)/documents/parties/$(code)).data.hostUid == request.auth.uid);
      }
      // Live chat: anyone in the room can read and write their own messages (up to 500 characters).
      match /messages/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/parties/$(code)).data.hostUid == request.auth.uid);
      }
      // Voice call set-up notes between two phones; only the receiver can read or remove them.
      match /signals/{id} {
        allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      }
    }

    // Tagalog dub episodes: everyone can read (the player looks one up by anime id and episode),
    // only the developer adds or removes them.
    match /tagdub/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
