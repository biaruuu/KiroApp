rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything a user saves lives under users/{their uid} and only they can touch it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
